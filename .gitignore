# ---- Données : jamais versionnées ----
data/*
!data/.gitkeep

# ---- Extractions ERP ----
*.xlsx
*.xls
*.csv

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---- Mise en service Windows : binaires, reconstruits à la demande ----
composants/
python-embed/

# ---- Systèmes ----
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- Vérifications locales avec des valeurs réelles ----
tests/test_local_*.py

# ---- Outils de l'assistant de développement, propres au poste ----
.agents/
.claude/

# ---- Référentiel réel de l'entreprise : JAMAIS versionné (regle 9) ----
# Noms de produits, marques, procedes. Le generateur versionne est
# generer_donnees_test.py, entierement fictif.
*_entreprise.py
*_reel.py
referentiel_local*

# ---- Éléments de marque : hors dépôt (regle 9) ----
# Le logo et les visuels de l'entreprise ne sont pas versionnés. L'application
# les charge s'ils sont présents, et fonctionne sans.
assets/*
!assets/.gitkeep

# Aucune image a la racine du depot : les visuels vivent dans assets/, exclu.
/*.png
/*.jpg
/*.jpeg
/*.svg
/*.webp
